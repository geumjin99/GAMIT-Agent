# Copy to .env (repo root) and edit; `docker compose` reads this file automatically.
# Do NOT commit your real .env (the key lives here).

# Your installed GAMIT/GLOBK root (mounted to /gg in the container)
GG_PATH=/home/you/gg

# Your bare RINEX / data pool (mounted read-only to /data)
DATA_PATH=/mnt/your/rinex

# OpenAI-compatible credentials (leave the key empty to enter it in the UI Settings instead)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Folder-browser start directory inside the container (defaults to /data)
GAMIT_BROWSE_ROOT=/data
