# Copy this to app/.env and fill in your own key (bring-your-own-key).
# The engine is OpenAI-compatible; to switch models change these three plus the matching key.
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional: point at another OpenAI-compatible backend (premium tier)
# DEEPSEEK_BASE_URL=https://api.openai.com/v1   ;  DEEPSEEK_MODEL=gpt-4.1
# or a local ollama: DEEPSEEK_BASE_URL=http://localhost:11434/v1
